<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:hello-devops:participants"
           elementFormDefault="qualified">

    <!-- Demande : un identifiant entier. -->
    <xs:element name="chercherParticipantRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Réponse : le résultat de la recherche, puis la fiche si elle existe. -->
    <xs:element name="chercherParticipantResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="trouve" type="xs:boolean"/>
                <xs:element name="id" type="xs:int" minOccurs="0"/>
                <xs:element name="prenom" type="xs:string" minOccurs="0"/>
                <xs:element name="age" type="xs:int" minOccurs="0"/>
                <xs:element name="ville" type="xs:string" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
